# Sauna 로컬 개발 비밀 템플릿
# 사용:
#   cp .env.example .env
#   docker compose up -d
#
# .env 는 .gitignore 에 포함 — 커밋 금지.

# ---- Postgres ----
POSTGRES_DB=sauna_dev
POSTGRES_USER=sauna
# 로컬 dev 전용 — prod 자격증명을 절대 여기에 두지 말 것
POSTGRES_PASSWORD=dev

# ---- Redis ----
# 로컬 Redis 는 패스워드 없이 사용. prod 는 ElastiCache + AUTH token.
# REDIS_PASSWORD=

# ---- Server ----
# Vapor 서버가 읽을 연결 문자열 (server/.env 와 일치 권장)
# DATABASE_URL=postgres://sauna:dev@localhost:5432/sauna_dev
# REDIS_URL=redis://localhost:6379

# ---- Apple Passkey (WebAuthn) ----
# 로컬 dev 도메인. mkcert 등으로 https 갖춘 후 사용.
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_RP_NAME=Sauna (local)
# WEBAUTHN_ORIGINS=https://localhost:8443

# ---- APNs (선택) ----
# 로컬에서 푸시 테스트 시 .p8 키 경로/팀 ID
# APNS_TEAM_ID=
# APNS_KEY_ID=
# APNS_KEY_PATH=
# APNS_BUNDLE_ID=th1ngjin.Sauna

# ---- Sentry (선택) ----
# SENTRY_DSN=
