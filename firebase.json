{
  "functions": [
    {
      "source": "functions",
      "codebase": "sauna",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "firestore": {
    "rules": "functions/firestore.rules",
    "indexes": "functions/firestore.indexes.json"
  },
  "hosting": {
    "public": "functions/public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/health", "function": { "functionId": "health", "region": "asia-northeast3" } },
      { "source": "/rooms", "function": { "functionId": "rooms", "region": "asia-northeast3" } },
      { "source": "/rooms/*/send", "function": { "functionId": "sendMessage", "region": "asia-northeast3" } },
      { "source": "/rooms/*/occupancy", "function": { "functionId": "occupancy", "region": "asia-northeast3" } },
      { "source": "/messages/cleanup", "function": { "functionId": "cleanupMessages", "region": "asia-northeast3" } }
    ]
  }
}
