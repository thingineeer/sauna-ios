rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Sauna 컬렉션 ────────────────────────────────────────────────
    // 메시지: 클라 직접 write 차단 (오직 Cloud Function 의 admin SDK 만).
    //         read 는 인증된 사용자 한정.
    match /sauna_messages/{id} {
      allow read: if request.auth != null;
      allow create, update, delete: if false;
    }

    // Presence: 본인 doc 만 write/delete. read 는 인증 사용자 누구나.
    match /sauna_presence/{userId} {
      allow read: if request.auth != null;
      allow write, delete: if request.auth != null && request.auth.uid == userId;
    }

    // ─── i-lunch 기존 컬렉션 (영향 X — 기본 default-deny 룰만 존재) ─────
    match /restaurants/{id} {
      allow read, write: if true;
    }
  }
}
