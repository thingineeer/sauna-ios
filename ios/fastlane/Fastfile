# Sauna · Fastlane (Tuist 기반)
#
# 흐름:
#   make generate       → Tuist 로 ios/Sauna.xcworkspace + 14× .xcodeproj 생성
#   bundle exec fastlane beta
#       → build_app (Release)
#       → upload_to_testflight
#
# 필요한 ENV:
#   FASTLANE_TEAM_ID
#   FASTLANE_ITC_TEAM_ID
#   APP_STORE_CONNECT_API_KEY_KEY_ID
#   APP_STORE_CONNECT_API_KEY_ISSUER_ID
#   APP_STORE_CONNECT_API_KEY_KEY  (PEM, base64, or path to .p8)

default_platform(:ios)

# Tuist 가 만든 워크스페이스와 App 타겟의 .xcodeproj 경로.
# `increment_build_number` 는 plist 를 직접 만지므로 .xcodeproj 가 필요.
WORKSPACE     = "Sauna.xcworkspace".freeze
APP_XCODEPROJ = "Projects/App/Sauna/Sauna.xcodeproj".freeze
APP_SCHEME    = "Sauna".freeze

platform :ios do

  before_all do
    unless File.exist?("../#{WORKSPACE}")
      UI.user_error!("ios/#{WORKSPACE} 가 없습니다. 'make install && make generate' 부터 실행하세요.")
    end
    unless File.exist?("../#{APP_XCODEPROJ}")
      UI.user_error!("ios/#{APP_XCODEPROJ} 가 없습니다. 'make generate' 가 먼저 돌아야 합니다.")
    end
  end

  desc "테스트 + 빌드 (TestFlight 업로드 안 함)"
  lane :build_only do
    run_tests(
      workspace: WORKSPACE,
      scheme: APP_SCHEME,
      devices: ["iPhone 16"]
    )
    build_app(
      workspace: WORKSPACE,
      scheme: APP_SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      clean: true
    )
  end

  desc "TestFlight 베타 업로드"
  lane :beta do
    setup_ci if is_ci

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_KEY"],
      is_key_content_base64: true,
      duration: 1200,
      in_house: false
    )

    increment_build_number(
      build_number: latest_testflight_build_number(api_key: api_key) + 1,
      xcodeproj: APP_XCODEPROJ
    )

    build_app(
      workspace: WORKSPACE,
      scheme: APP_SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      clean: true
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      changelog: ENV["FASTLANE_CHANGELOG"] || "내부 베타 빌드 — 황토방 진입 테스트"
    )
  end

  desc "App Store 정식 배포 (수동 확인)"
  lane :release do
    UI.user_error!("v1 단계에서는 App Store 배포 lane 미사용. TestFlight 만 운영.")
  end
end
