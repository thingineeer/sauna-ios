# Sauna · Fastlane secrets 템플릿
#
# 실제 .env.fastlane 은 .gitignore 에 잡혀야 함 (이미 .env 가 ignore 됨).
# CI 에서는 GitHub Actions secrets 로 주입.

# Apple Developer team id (10자 alphanumeric)
FASTLANE_TEAM_ID=ABCDE12345

# App Store Connect team id (다른 팀일 수 있음)
FASTLANE_ITC_TEAM_ID=12345678

# App Store Connect API key (key_id / issuer_id / key 자체)
# https://appstoreconnect.apple.com/access/users#/api
APP_STORE_CONNECT_API_KEY_KEY_ID=ABCD1234EF
APP_STORE_CONNECT_API_KEY_ISSUER_ID=12345678-aaaa-bbbb-cccc-dddddddddddd
# .p8 의 내용을 base64 한 값. CI 시크릿 한 줄에 담기 위함.
APP_STORE_CONNECT_API_KEY_KEY=BASE64_OF_P8_CONTENT_HERE

# 옵션: 변경 사항 텍스트 (TestFlight 업로드 시 노출)
FASTLANE_CHANGELOG="내부 베타 빌드"
